graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': ['F', 'G'],
    'F': [],
    'G': []
}

visited = set()
path = []

def dfs(node):
    visited.add(node)
    path.append(node)

    print("Visiting:", node)

    for neighbour in graph[node]:
        if neighbour not in visited:
            dfs(neighbour)

    print("Backtracking from:", node)

start = 'A'

dfs(start)

print("\nExploration Path:")
print(path)

print("Visited Chambers:")
print(visited)
